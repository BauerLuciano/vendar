APP_NAME=VendAR
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

MP_PUBLIC_URL=

# Orígenes permitidos para back_urls del retorno de pago (suscripción), separados por coma.
# Si se omite, se usan http://localhost, http://127.0.0.1 y http://vendar-app.test.
# En runtime también se aceptan los orígenes derivados de APP_URL y MP_PUBLIC_URL.
# MP_ALLOWED_RETURN_ORIGINS=http://localhost,http://127.0.0.1,http://vendar-app.test

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vendar
DB_USERNAME=vendar
DB_PASSWORD=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

EANSEARCH_ENABLED=false
EANSEARCH_API_TOKEN=
EANSEARCH_MAX_REQUESTS=100

GEOAPIFY_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ARCA (Facturación Electrónica) - endpoints por entorno
# Por defecto los endpoints ya apuntan a los WSDLs oficiales; sobrescribir
# solo para tests o despliegues con proxy. El entorno del comercio (produccion
# u homologacion) se configura en el wizard fiscal, nunca por .env.
ARCA_WSAA_WSDL_PRODUCCION=https://wsaa.afip.gov.ar/ws/services/LoginCms?WSDL
ARCA_WSAA_WSDL_HOMOLOGACION=https://wsaahomo.afip.gov.ar/ws/services/LoginCms?WSDL
ARCA_WSAA_TTL_SEGUNDOS=600
ARCA_WSFE_WSDL_PRODUCCION=https://servicios1.afip.gov.ar/wsfev1/service.asmx?WSDL
ARCA_WSFE_WSDL_HOMOLOGACION=https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL
ARCA_PADRON_WSDL_PRODUCCION=https://aws.arca.gob.ar/sr-padron/webservices/personaServiceA5?WSDL
ARCA_PADRON_WSDL_HOMOLOGACION=https://awshomo.arca.gob.ar/sr-padron/webservices/personaServiceA5?WSDL
ARCA_SOAP_TIMEOUT=30
