APP_NAME=VendAR
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

MP_PUBLIC_URL=

# Orígenes permitidos para back_urls del retorno de pago (suscripción), separados por coma.
# Si se omite, se usan http://localhost, http://127.0.0.1 y http://vendar-app.test.
# En runtime también se aceptan los orígenes derivados de APP_URL y MP_PUBLIC_URL.
# MP_ALLOWED_RETURN_ORIGINS=http://localhost,http://127.0.0.1,http://vendar-app.test

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vendar
DB_USERNAME=vendar
DB_PASSWORD=

MERCADOPAGO_ACCESS_TOKEN=
# Secret de la app en el panel de Mercado Pago ("Tus aplicaciones" > tu app >
# "Secreto de firma"). OBLIGATORIO en producción: sin él, el webhook de
# suscripción responde 401 y la renovación nunca se aplica.
MERCADOPAGO_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

EANSEARCH_ENABLED=false
EANSEARCH_API_TOKEN=
EANSEARCH_MAX_REQUESTS=100

GEOAPIFY_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
